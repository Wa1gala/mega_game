[sub_resource type="Shader" id="scanline_shader"]
code = "shader_type canvas_item;

void fragment() {
	float row = SCREEN_UV.y / SCREEN_PIXEL_SIZE.y;
	float line = float(int(row) % 3 == 0);
	COLOR = vec4(0.0, 0.0, 0.0, line * 0.18);
}"

[sub_resource type="ShaderMaterial" id="scanline_material"]
